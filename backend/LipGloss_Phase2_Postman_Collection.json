{
  "info": {
    "name": "LipGloss Catalog — Phase 2 Commerce",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "API commerce tests. Keep auth tokens private. Use one UUID per checkout and reuse it on retries."
  },
  "item": [
    {
      "name": "Get Cart",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{user_token}}"
          }
        ],
        "url": "{{base_url}}/api/cart/"
      }
    },
    {
      "name": "Add Cart Item",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{user_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/cart/items/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"product_id\": 1,\n  \"quantity\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Update Cart Item",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{user_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/cart/items/{{cart_item_id}}/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"quantity\": 3\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Delete Cart Item",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{user_token}}"
          }
        ],
        "url": "{{base_url}}/api/cart/items/{{cart_item_id}}/"
      }
    },
    {
      "name": "Checkout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{user_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/orders/checkout/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idempotency_key\": \"{{checkout_key}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "My Orders",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{user_token}}"
          }
        ],
        "url": "{{base_url}}/api/orders/"
      }
    },
    {
      "name": "My Order Details",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{user_token}}"
          }
        ],
        "url": "{{base_url}}/api/orders/{{order_id}}/"
      }
    },
    {
      "name": "Admin All Orders",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{admin_token}}"
          }
        ],
        "url": "{{base_url}}/api/admin/orders/"
      }
    },
    {
      "name": "Admin Confirm Order",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{admin_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/admin/orders/{{order_id}}/status/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"confirmed\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Admin Ship Order",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{admin_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/admin/orders/{{order_id}}/status/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"shipped\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Admin Deliver Order",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{admin_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/admin/orders/{{order_id}}/status/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"delivered\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Admin Cancel Order",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{admin_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/admin/orders/{{order_id}}/status/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"cancelled\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Invalid Quantity Test",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{user_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/cart/items/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"product_id\": 1,\n  \"quantity\": 0\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Invalid Checkout Key Test",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{user_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/orders/checkout/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idempotency_key\": \"invalid\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "user_token",
      "value": ""
    },
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "cart_item_id",
      "value": "1"
    },
    {
      "key": "order_id",
      "value": "1"
    },
    {
      "key": "checkout_key",
      "value": "d08b2d62-2b67-4a71-9487-72ce95f7c4ea"
    }
  ]
}